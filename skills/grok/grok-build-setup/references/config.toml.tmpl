# Project-scoped Grok Build config
# Only [mcp_servers], [plugins], and [permission] load from project .grok/config.toml
# Global settings live in ~/.grok/config.toml

[permission]
deny = [
  'bash(rm -rf *)',
  'bash(sudo *)',
  'bash(curl * | sh)',
  'bash(wget * | sh)',
]

